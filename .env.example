# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
FLASK_DEBUG=false

# ---- Upload limits ----
MAX_FILE_SIZE_MB=10
MIN_FILES_PER_ANALYSIS=2
MAX_FILES_PER_ANALYSIS=10

# ---- Sentence segmentation ----
SPACY_MODEL=en_core_web_sm
MIN_SENTENCE_CHARS=25
MIN_SENTENCE_WORDS=4

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# ---- Candidate selection (cost controls) ----
SIMILARITY_THRESHOLD=0.65
TOP_K_CANDIDATES=5
MAX_CANDIDATE_PAIRS=100
EMBEDDING_BATCH_SIZE=64
MAX_SENTENCES_PER_ANALYSIS=400

# ---- Reasoning ----
REASONING_BATCH_SIZE=8
MAX_OUTPUT_TOKENS=1400

# ---- Document chat ----
CHAT_TOP_K=8
CHAT_MAX_OUTPUT_TOKENS=700
CHAT_SUGGESTION_TOKENS=200

# ---- Cost estimation (USD per 1M tokens, list prices) ----
PRICE_EMBEDDING_PER_MTOK=0.02
PRICE_REASONING_INPUT_PER_MTOK=0.40
PRICE_REASONING_OUTPUT_PER_MTOK=1.60
